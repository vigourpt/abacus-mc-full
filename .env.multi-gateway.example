JARVIS_GATEWAY_URL=ws://localhost:45397
JARVIS_GATEWAY_TOKEN=your_jarvis_token_here

# Thor Gateway (VPS)
THOR_GATEWAY_URL=ws://187.124.114.207:45397
THOR_GATEWAY_TOKEN=your_thor_token_here

